# duplicate for use (.env)

# path to the external dump archive
# expects 2 sub-directories: raw (.7z and .xml) and processed (.parquet)
DATA_DUMP=SOME_PATH

# hugging face (fast path)
# HF_TOKEN required for push / pull operations (not for local dataset ingestion)
# HF_REPO_ID optional; defaults to the team's repo in constants.py
HF_TOKEN=YOUR_HUGGING_FACE_TOKEN